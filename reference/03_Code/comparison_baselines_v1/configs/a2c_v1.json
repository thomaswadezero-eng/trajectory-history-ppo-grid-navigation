{
  "schema_version": "comparison_baselines.method_config.v1",
  "status": "FROZEN_BEFORE_FORMAL_RUNS",
  "method": "A2C",
  "algorithm_definition": "Synchronous on-policy advantage actor-critic with one update per complete rollout",
  "network_head": "separate_actor_256_128_4_and_critic_256_128_1",
